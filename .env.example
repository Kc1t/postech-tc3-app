APP_PORT=8080
APP_ENV=development
LOG_LEVEL=info

POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/workshop?sslmode=disable

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXP_MIN=15
REFRESH_TOKEN_EXP_DAYS=7
BCRYPT_COST=12

# Account lockout (brute force protection)
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MIN=15

ADMIN_EMAIL=admin@workshop.com
ADMIN_PASSWORD=change-me-in-production

# Email (Brevo SMTP — smtp-relay.brevo.com)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=seu-login@smtp-brevo.com
SMTP_PASSWORD=sua-smtp-key
SMTP_FROM=noreply@seudominio.com
