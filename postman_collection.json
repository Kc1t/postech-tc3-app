{
  "info": {
    "name": "Postech TC3 - Workshop API",
    "description": "Sistema Integrado de Atendimento e Execucao de Servicos - Oficina Mecanica.\n\nVariaveis:\n- base_url: http://localhost:8080/api/v1\n- token: setado automaticamente pelo Login\n- refresh_token: setado automaticamente pelo Login\n\nFluxo sugerido: Auth > Login > demais endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "gateway_url",
      "value": "https://SEU-API-ID.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "cpf",
      "value": "52998224725"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Fase 3 - Autenticacao por CPF (API Gateway)",
      "description": "Rotas expostas pelo API Gateway. `POST /auth` e aberta e emite o JWT a partir do CPF; as rotas sob `/api/v1` passam pelo authorizer Lambda. Preencha a variavel `gateway_url` com o endpoint do gateway.",
      "item": [
        {
          "name": "Emitir token por CPF (sucesso)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/auth",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "Cliente ativo. Devolve 200 e grava o token na variavel de colecao.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpf}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200 && body.access_token) {",
                  "  pm.collectionVariables.set('token', body.access_token);",
                  "  pm.test('token emitido', () => pm.expect(body.token_type).to.eql('Bearer'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "CPF invalido (400)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/auth",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "Digito verificador invalido. A Lambda rejeita antes de consultar o banco.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"111.111.111-11\"\n}"
            }
          }
        },
        {
          "name": "Cliente inexistente (404)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/auth",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "CPF valido, mas sem cadastro em `requesters`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"390.533.447-05\"\n}"
            }
          }
        },
        {
          "name": "Cliente inativo (403)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/auth",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "CPF valido e cadastrado, mas com `status = inactive`. Troque pelo CPF do cliente desativado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"SUBSTITUA_PELO_CPF_INATIVO\"\n}"
            }
          }
        },
        {
          "name": "Rota protegida SEM token (401 no gateway)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/service-orders/code/1",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "service-orders",
                "code",
                "1"
              ]
            },
            "description": "O authorizer barra antes de a requisicao chegar na aplicacao."
          }
        },
        {
          "name": "Rota protegida COM token (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/service-orders/code/1",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "service-orders",
                "code",
                "1"
              ]
            },
            "description": "Usa o token emitido pelo CPF. O middleware da aplicacao valida o mesmo JWT."
          }
        },
        {
          "name": "Aprovar orcamento como cliente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/service-orders/code/1/status",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "service-orders",
                "code",
                "1",
                "status"
              ]
            },
            "description": "Transicao permitida ao solicitante: `in_execution` aprova, `received` recusa.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_execution\",\n  \"requester_document\": \"{{cpf}}\"\n}"
            }
          }
        },
        {
          "name": "Healthcheck (rota aberta)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Usada pelas probes do Kubernetes e pelo monitoramento de uptime."
          }
        }
      ]
    },
