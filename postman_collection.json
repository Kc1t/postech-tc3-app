            }
          }
        },
        {
          "name": "Delete Service",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/services/:id", "host": ["{{base_url}}"], "path": ["services", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        }
      ]
    },
    {
      "name": "Parts",
      "item": [
        {
          "name": "Create Part",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/parts", "host": ["{{base_url}}"], "path": ["parts"] },
            "body": {
