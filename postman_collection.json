            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"XYZ9A87\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla Cross\",\n  \"year\": 2023\n}"
            }
          }
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/vehicles/:id", "host": ["{{base_url}}"], "path": ["vehicles", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        }
      ]
    },
    {
