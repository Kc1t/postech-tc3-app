            "url": { "raw": "{{base_url}}/parts/:id", "host": ["{{base_url}}"], "path": ["parts", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Adjust Stock",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/parts/:id/stock", "host": ["{{base_url}}"], "path": ["parts", ":id", "stock"], "variable": [{ "key": "id", "value": "" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": 10\n}"
            }
          }
        }
      ]
    }
  ]
}
