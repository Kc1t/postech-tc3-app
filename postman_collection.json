{
  "info": {
    "name": "Postech TC1 - Workshop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/customers", "host": ["{{base_url}}"], "path": ["customers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"document\": \"52998224725\",\n  \"email\": \"joao@email.com\",\n  \"phone\": \"11999990000\"\n}"
            }
          }
        },
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/customers", "host": ["{{base_url}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/customers/:id", "host": ["{{base_url}}"], "path": ["customers", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Get Customer by Document",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/customers/document/:document", "host": ["{{base_url}}"], "path": ["customers", "document", ":document"], "variable": [{ "key": "document", "value": "52998224725" }] }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/customers/:id", "host": ["{{base_url}}"], "path": ["customers", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva Atualizado\",\n  \"email\": \"joao.novo@email.com\",\n  \"phone\": \"11888880000\"\n}"
            }
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/customers/:id", "host": ["{{base_url}}"], "path": ["customers", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        }
      ]
    },
